# Copie este arquivo para ".env" e preencha com os valores reais.
# O .env NÃO deve ser commitado (já está no .gitignore).

# String de conexão com o Postgres (local ou Supabase), usada pela aplicação e pelas migrations.
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/estacao_chopp"

# Chave secreta para assinar os tokens JWT. Use um valor longo e aleatório.
JWT_SECRET="defina_uma_chave_secreta_forte_aqui"

# Porta em que o servidor backend sobe.
PORT=3001
